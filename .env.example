# Optional. The app already points at Curby's Supabase project (see src/lib/supabase.ts).
# Copy to .env only to use a different project, e.g. a local `supabase start` stack.
# Use the publishable key (sb_publishable_...) or legacy anon key. Never the secret/service_role key.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Only needed for Android release builds (Google Cloud → Maps SDK for Android)
GOOGLE_MAPS_ANDROID_API_KEY=
